{
  "name": "@metaplex-foundation/agent-tools",
  "version": "0.1.0",
  "description": "Mastra tool catalog for Metaplex agents — defineTool + createToolset + bundles",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx --test-reporter spec 'test/**/*.test.ts'",
    "test:unit": "node --test --import tsx --test-reporter spec 'test/unit/**/*.test.ts'",
    "test:integration": "node --test --import tsx --test-reporter spec 'test/integration/**/*.test.ts'"
  },
  "dependencies": {
    "@mastra/core": "^1.24.0",
    "@metaplex-foundation/agent-runtime": "workspace:*",
    "@metaplex-foundation/genesis": "^0.35.0",
    "@metaplex-foundation/mpl-agent-registry": "^0.2.5",
    "@metaplex-foundation/mpl-core": "^1.9.1",
    "@metaplex-foundation/mpl-toolbox": "^0.10.0",
    "@metaplex-foundation/umi": "^1.1.0",
    "@noble/hashes": "1.7.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "nock": "^14.0.15",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
