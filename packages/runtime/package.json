{
  "name": "@metaplex-foundation/agent-runtime",
  "version": "0.1.0",
  "description": "Shared runtime (Umi, config, state, auth, jupiter, banner) for Metaplex Mastra agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx --test-reporter spec 'test/**/*.test.ts'",
    "test:unit": "node --test --import tsx --test-reporter spec 'test/unit/**/*.test.ts'",
    "test:integration": "node --test --import tsx --test-reporter spec 'test/integration/**/*.test.ts'"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.9.1",
    "@metaplex-foundation/mpl-toolbox": "^0.10.0",
    "@metaplex-foundation/umi": "^1.1.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.1.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "nock": "^14.0.15",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
